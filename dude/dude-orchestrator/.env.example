# Experimental service. No default connection or secret; do not commit .env.
# Same database as dude-admin (existing deployments normally use alfred).
DUDE_ORCHESTRATOR_DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/alfred
# Must match dude-admin's JWT_SECRET; at least 32 UTF-8 bytes.
JWT_SECRET=
DUDE_ORCHESTRATOR_HOST=127.0.0.1
DUDE_ORCHESTRATOR_PORT=8010
