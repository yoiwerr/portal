{
  "name": "@dude/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "migrate": "node dist/src/db/migrate.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:db": "bash scripts/test-postgres.sh"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
