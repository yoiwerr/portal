# ============================================================
# Portal 环境变量模板
# 复制为 .env 后填入实际值
# ============================================================

# --- LLM Provider (必填至少一个) ---
LLM_PROVIDER=auto
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120.0

# DashScope (阿里通义千问 — 默认)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# DeepSeek (dude 可选提供方)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (可选)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Local vLLM / Ollama (可选)
# LOCAL_LLM_URL=http://localhost:8000/v1

# --- LLM 参数 ---
MAX_TOOL_ROUNDS=10
AGENT_TIMEOUT=180.0

# --- PostgreSQL (Portal 根级共享实例；保留已有密码和数据卷) ---
PGSQLPASSWORD=replace-with-existing-postgres-admin-password
DB_HOST=localhost          # DB_* 优先，兼容旧 PG_*；Compose 固定 postgres/alfred（现有数据库）
DB_PORT=5432
DB_NAME=alfred
DB_USER=postgres
# 旧 PG_* 仅在对应 DB_* 未设置时使用，不要配置成不同的目标。
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=alfred
PG_USER=postgres

# --- 历史 RAG 配置（主链路已停用，保留旧资料/工具兼容；无需嵌入 key） ---
RAG_TOP_K=3
SIMILARITY_THRESHOLD=0.6
RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
RERANK_TOP_K=5
RERANK_COARSE_K=20

# --- 当前规划参考 ---
# 在线只读已发布 Wiki；官方资料通过管理员 refresh -> compile -> publish 更新。
# 本地默认 dude/var/wiki-published；Compose 固定 /var/lib/dude-wiki。
# DUDE_WIKI_PUBLISHED_DIR=/absolute/path/to/wiki-published
# 首次安装允许人工种子页；有正式发布后建议设 false，缺版本会使健康检查失败。
DUDE_WIKI_ALLOW_SEED=true
# 跨会话向量记忆已停用；旧变量不再重新启用它。
MEMORY_ENABLED=false
# --- Agent ---
SANDBOX_ENABLED=false
SANDBOX_TIMEOUT=30.0

# Journal PostgreSQL (required in production; no weak defaults)
JOURNAL_DB_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes

MAKEITSPECIFIC_DB_PASSWORD=replace-with-random-password
ADMIN_INIT_PASSWORD=replace-with-strong-admin-password
