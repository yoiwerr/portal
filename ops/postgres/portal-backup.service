[Unit]
Description=Portal PostgreSQL daily backups
Requires=docker.service
After=docker.service
[Service]
Type=oneshot
User=root
Environment=PORTAL_DIR=/root/portal
Environment=BACKUP_DIR=/var/backups/portal/postgres
ExecStart=/root/portal/ops/postgres/backup.sh journal
ExecStart=/root/portal/ops/postgres/backup.sh alfred
