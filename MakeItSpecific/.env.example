# ============================================================
# Alfred — AI 工作流增强 Agent 环境变量
# 复制为 .env 后填入实际值
# ============================================================

# --- LLM Provider (必填至少一个) ---
LLM_PROVIDER=auto              # dashscope | deepseek | openai | local | auto
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120.0

# DashScope / 百炼 (阿里通义千问 — Embedding + Rerank 必须)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (可选)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o

# Local vLLM / Ollama (可选)
# LOCAL_LLM_URL=http://localhost:8000/v1

# --- PostgreSQL (Alfred 独占 PGVector 实例) ---
PGSQLPASSWORD=your-postgres-password
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=alfred
PG_USER=postgres

# --- Agent ---
MAX_TOOL_ROUNDS=10
AGENT_TIMEOUT=180.0
MAX_CLARIFY_ROUNDS=3
MAX_QUESTIONS_PER_ROUND=5
MEMORY_ENABLED=true
SANDBOX_ENABLED=false
SANDBOX_TIMEOUT=30.0

# --- RAG ---
RAG_TOP_K=3
RAG_CHUNK_MIN=200
RAG_CHUNK_MAX=800
SIMILARITY_THRESHOLD=0.6
RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
RERANK_TOP_K=5
RERANK_COARSE_K=20

# --- API ---
API_HOST=0.0.0.0
API_PORT=8001
